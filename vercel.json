{
  "framework": "vite",
  "buildCommand": "node -e \"if (require('fs').existsSync('frontend')) process.chdir('frontend'); require('child_process').execSync('npm run build', {stdio: 'inherit'});\"",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
